# Security headers (§12)
/
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'none'

# JS must be served with correct MIME
/assets/*
  X-Content-Type-Options: nosniff

# Audio MIME
/audio/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
